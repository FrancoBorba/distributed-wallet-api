{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Wallet service for game providers, with equivalent guarantees over HTTP and SQS.\n\n**Money** always travels as a decimal string with its currency, never as a number.\n\n**Idempotency**: an operation is identified by (providerId, externalTransactionId). Replaying it returns the stored result with `idempotentReplay: true` and the balance observed when it was originally processed. Reusing the key with a different body is a 409.\n\n**Status codes**: 200 processed, 202 accepted and waiting for a reference, 400 invalid input, 401 no credential, 403 acting for another provider, 404 not found, 409 idempotency conflict, 422 refused by a business rule with a stable `failureCode`, 503 transient, send it again.\n\n**Authentication**: every business endpoint requires an OAuth 2.0 bearer token issued by Keycloak through the client_credentials flow. The provider identity comes from the token, never from a header. Wallet operations are restricted to the internal service.",
        "title": "Distributed Wallet API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health/live": {
            "get": {
                "description": "Reports that the process is running. It touches no dependency, because a restart would not fix a database that is briefly unreachable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/HealthResponse"
                        }
                    }
                }
            }
        },
        "/health/ready": {
            "get": {
                "description": "Reports whether PostgreSQL and SQS answer. A failure returns 503 so the instance stops receiving traffic without being restarted.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/HealthResponse"
                        }
                    }
                }
            }
        },
        "/providers/{providerId}/wagering/transactions/{externalTransactionId}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Looks the operation up by the identifier the provider gave it, which is how a provider checks the outcome of something it sent without having stored our internal identifier.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wagering"
                ],
                "summary": "Read a transaction the way the provider knows it",
                "parameters": [
                    {
                        "type": "string",
                        "default": "provider-a",
                        "description": "Provider",
                        "name": "providerId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Identifier given by the provider",
                        "name": "externalTransactionId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/TransactionResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wagering/transactions": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Applies a BET, WIN, LOSS, REFUND or ROLLBACK to a wallet. The Idempotency-Key header is mandatory and is stored as received. Replaying the same key with an equivalent body returns the stored result with idempotentReplay true, and the balance it answers with is the one observed when the operation was originally processed, even if the wallet has moved since. Reusing the key with a different body is a conflict. A reversal whose reference has not arrived yet is accepted and answered with 202, and a worker resolves it later.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wagering"
                ],
                "summary": "Submit a provider operation",
                "parameters": [
                    {
                        "type": "string",
                        "default": "provider-a:transaction-123",
                        "description": "Idempotency key, e.g. {providerId}:{externalTransactionId}",
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Operation",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/WagerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Processed, or an idempotent replay of a processed operation",
                        "schema": {
                            "$ref": "#/definitions/WagerResponse"
                        }
                    },
                    "202": {
                        "description": "Accepted and waiting for the transaction it reverses",
                        "schema": {
                            "$ref": "#/definitions/WagerResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input or missing Idempotency-Key",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "No valid credential",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Acting on behalf of another provider",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Key reused with a different payload",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Refused by a business rule, with a stable failureCode",
                        "schema": {
                            "$ref": "#/definitions/WagerResponse"
                        }
                    },
                    "503": {
                        "description": "Transient unavailability, send the same request again",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wagering/transactions/{transactionId}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lets a provider follow a pending operation and read the failure code of a refused one. A provider only ever sees its own transactions.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wagering"
                ],
                "summary": "Read a transaction by its internal identifier",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Internal transaction identifier",
                        "name": "transactionId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/TransactionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wallets": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates the wallet of a player in one currency. A positive initial balance also creates the internal OPENING transaction already processed, its credit entry in the ledger and the corresponding events, all in the same commit. An initial balance of \"0.00\" creates the wallet alone. The pair (playerId, currency) identifies a wallet, so a second opening is a conflict.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallets"
                ],
                "summary": "Open a wallet",
                "parameters": [
                    {
                        "description": "Wallet to open",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/OpenWalletRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/WalletResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Restricted to the internal service",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "The player already has a wallet in this currency",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Transient unavailability",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wallets/{walletId}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallets"
                ],
                "summary": "Read a wallet",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Wallet identifier",
                        "name": "walletId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/WalletResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wallets/{walletId}/ledger": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the immutable entries of a wallet in a stable order. The cursor is opaque: send back the nextCursor of the previous page and do not interpret it. The absence of nextCursor means the last page was reached.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallets"
                ],
                "summary": "Page the wallet history",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Wallet identifier",
                        "name": "walletId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Opaque cursor of the previous page",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 50,
                        "description": "Page size (1-200)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/LedgerPageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wallets/{walletId}/reconciliation": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Rebuilds the balance from every ledger entry, including the opening credit, and compares it with the stored balance in one consistent view of the data. It never changes the balance. A divergence is reported in the response and in the logs.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallets"
                ],
                "summary": "Reconcile a wallet against its ledger",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Wallet identifier",
                        "name": "walletId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ReconciliationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "IDEMPOTENCY_CONFLICT"
                },
                "message": {
                    "type": "string",
                    "example": "idempotency key was already used with a different payload"
                }
            }
        },
        "HealthResponse": {
            "type": "object",
            "properties": {
                "checks": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ok",
                        "degraded"
                    ],
                    "example": "ok"
                }
            }
        },
        "LedgerEntryResponse": {
            "type": "object",
            "properties": {
                "balanceAfter": {
                    "$ref": "#/definitions/Money"
                },
                "balanceBefore": {
                    "$ref": "#/definitions/Money"
                },
                "createdAt": {
                    "type": "string",
                    "example": "2026-09-20T12:00:00Z"
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "DEBIT",
                        "CREDIT"
                    ],
                    "example": "DEBIT"
                },
                "id": {
                    "type": "string"
                },
                "money": {
                    "$ref": "#/definitions/Money"
                },
                "transactionId": {
                    "type": "string"
                }
            }
        },
        "LedgerPageResponse": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/LedgerEntryResponse"
                    }
                },
                "nextCursor": {
                    "type": "string"
                },
                "walletId": {
                    "type": "string"
                }
            }
        },
        "Money": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "string",
                    "example": "25.00"
                },
                "currency": {
                    "type": "string",
                    "example": "BRL"
                }
            }
        },
        "OpenWalletRequest": {
            "type": "object",
            "properties": {
                "initialBalance": {
                    "$ref": "#/definitions/Money"
                },
                "playerId": {
                    "type": "string",
                    "example": "0192f28f-5dc0-7d58-bdb2-814ad6a0f4a1"
                }
            }
        },
        "ReconciliationResponse": {
            "type": "object",
            "properties": {
                "calculatedBalance": {
                    "$ref": "#/definitions/Money"
                },
                "checkedEntries": {
                    "type": "integer",
                    "example": 2
                },
                "consistent": {
                    "type": "boolean",
                    "example": true
                },
                "difference": {
                    "$ref": "#/definitions/Money"
                },
                "storedBalance": {
                    "$ref": "#/definitions/Money"
                },
                "walletId": {
                    "type": "string"
                }
            }
        },
        "TransactionResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string",
                    "example": "2026-09-20T12:00:00Z"
                },
                "externalTransactionId": {
                    "type": "string"
                },
                "failureCode": {
                    "type": "string"
                },
                "gameId": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "example": "BET"
                },
                "money": {
                    "$ref": "#/definitions/Money"
                },
                "playerId": {
                    "type": "string"
                },
                "providerId": {
                    "type": "string"
                },
                "referenceExternalTransactionId": {
                    "type": "string"
                },
                "referenceTransactionId": {
                    "type": "string"
                },
                "resultBalance": {
                    "$ref": "#/definitions/Money"
                },
                "roundId": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "PROCESSED"
                },
                "transactionId": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string",
                    "example": "2026-09-20T12:00:00Z"
                },
                "walletId": {
                    "type": "string"
                }
            }
        },
        "WagerRequest": {
            "type": "object",
            "properties": {
                "externalTransactionId": {
                    "type": "string",
                    "example": "transaction-123"
                },
                "gameId": {
                    "type": "string",
                    "example": "fortune-chimp"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "BET",
                        "WIN",
                        "LOSS",
                        "REFUND",
                        "ROLLBACK"
                    ],
                    "example": "BET"
                },
                "money": {
                    "$ref": "#/definitions/Money"
                },
                "playerId": {
                    "type": "string",
                    "example": "0192f28f-5dc0-7d58-bdb2-814ad6a0f4a1"
                },
                "providerId": {
                    "type": "string",
                    "example": "provider-a"
                },
                "referenceExternalTransactionId": {
                    "type": "string",
                    "example": ""
                },
                "roundId": {
                    "type": "string",
                    "example": "round-987"
                },
                "walletId": {
                    "type": "string",
                    "example": "0192f291-27dd-7d3f-8071-5f8685deef37"
                }
            }
        },
        "WagerResponse": {
            "type": "object",
            "properties": {
                "balance": {
                    "$ref": "#/definitions/Money"
                },
                "failureCode": {
                    "type": "string",
                    "example": ""
                },
                "idempotentReplay": {
                    "type": "boolean",
                    "example": false
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "PROCESSED",
                        "REJECTED",
                        "PENDING_REFERENCE",
                        "FAILED"
                    ],
                    "example": "PROCESSED"
                },
                "transactionId": {
                    "type": "string",
                    "example": "0192f298-345e-7e38-af88-e43f851a819d"
                }
            }
        },
        "WalletResponse": {
            "type": "object",
            "properties": {
                "balance": {
                    "$ref": "#/definitions/Money"
                },
                "id": {
                    "type": "string",
                    "example": "0192f291-27dd-7d3f-8071-5f8685deef37"
                },
                "playerId": {
                    "type": "string",
                    "example": "0192f28f-5dc0-7d58-bdb2-814ad6a0f4a1"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Token OAuth 2.0 obtido no Keycloak pelo fluxo client_credentials. Informe \"Bearer \" seguido do token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "Wallet operations, restricted to the internal service",
            "name": "wallets"
        },
        {
            "description": "Provider operations over a wallet",
            "name": "wagering"
        },
        {
            "description": "Public liveness and readiness probes",
            "name": "health"
        }
    ]
}