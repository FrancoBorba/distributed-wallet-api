# Example configuration with local values. No real secret belongs in this file.
#
# Every setting has a default that makes the Docker Compose environment work
# with no environment file at all, so this exists to document what can be
# changed and what each value means, not because it has to be filled in.
#
# The values below are the ones for running the service on the host, against
# the dependencies started by Docker Compose. Inside Compose the service reads
# the equivalents already set in docker-compose.yaml.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://wager_user:wager_password@localhost:5432/wager_db?sslmode=disable

# The pool is shared by the HTTP requests and every worker, so it has to be
# large enough for CONSUMER_CONCURRENCY plus the publisher batch plus traffic.
DB_MAX_CONNECTIONS=20
DB_CONNECT_TIMEOUT=10s

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Port 8081 and not 8080, which is where Keycloak listens.
HTTP_ADDRESS=:8081
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Setting this to false makes the service trust the X-Provider-Id and
# X-Service-Role headers without any verification. It is a development aid and
# must never be used anywhere reachable by an untrusted network.
OIDC_ENABLED=true

# What the iss claim of every accepted token must say.
OIDC_ISSUER=http://localhost:8080/realms/wager

# Where the public keys are read from, when that is not the issuer itself. It
# is only needed when the service reaches the identity provider through a name
# the tokens do not carry, which is the case inside Docker.
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/wager

# What the aud claim must contain. This is what stops a token minted for
# another service in the same realm from being replayed here.
OIDC_AUDIENCE=wallet-api

# The realm role that marks the internal service, and the claim that carries
# the provider identity.
OIDC_INTERNAL_ROLE=wallet-internal
OIDC_PROVIDER_CLAIM=azp

OIDC_DISCOVERY_TIMEOUT=30s

# ---------------------------------------------------------------------------
# SQS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Points the SDK at LocalStack. Leave it empty against real AWS, so the
# credentials resolve through the default chain.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_INBOUND_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wallet-events.fifo

# ---------------------------------------------------------------------------
# SQS consumer
# ---------------------------------------------------------------------------
# Every instance shares this name, because they are one logical consumer
# competing for the same messages. It is the key of the inbox.
CONSUMER_NAME=wager-transactions-consumer

CONSUMER_MAX_MESSAGES=10

# The long polling window. 20s is the maximum SQS accepts.
CONSUMER_WAIT_TIME=20s

# This must stay longer than CONSUMER_HANDLER_TIMEOUT, otherwise a message
# becomes visible again while it is still being handled and a second consumer
# picks up an operation that is already in flight. The service refuses to start
# if the two are inverted.
CONSUMER_VISIBILITY_TIMEOUT=60s
CONSUMER_HANDLER_TIMEOUT=30s
CONSUMER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Outbox publisher
# ---------------------------------------------------------------------------
# Defaults to the host name, which is the container id under Docker and is
# enough to tell competing publishers apart in a claim.
# OUTBOX_PUBLISHER_ID=outbox-publisher@instance-1

OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=1s

# How long a claim holds an event. A publisher that dies blocks its events for
# at most this long before another instance takes them over.
OUTBOX_CLAIM_LEASE=30s
OUTBOX_RETRY_BASE_DELAY=2s
OUTBOX_RETRY_MAX_DELAY=5m

# ---------------------------------------------------------------------------
# Pending reference worker
# ---------------------------------------------------------------------------
# REFERENCE_WORKER_ID=reference-resolver@instance-1
REFERENCE_BATCH_SIZE=25
REFERENCE_POLL_INTERVAL=2s
REFERENCE_CLAIM_LEASE=30s
REFERENCE_RETRY_BASE_DELAY=2s
REFERENCE_RETRY_MAX_DELAY=2m

# The budget of a reversal waiting for the transaction it reverses. Either
# limit ends the wait on its own, and reaching it refuses the operation with
# REFERENCE_NOT_FOUND. Lower these to watch an expiry happen quickly.
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL=30m

# ---------------------------------------------------------------------------
# Shutdown
# ---------------------------------------------------------------------------
# How long the workers and the HTTP server get to finish what they hold before
# the process gives up waiting.
SHUTDOWN_TIMEOUT=30s
